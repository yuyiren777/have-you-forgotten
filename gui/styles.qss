/* Have you forgotten? - quiet desktop productivity theme */
* {
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13pt;
    color: #24313D;
}

QMainWindow, QWidget#HomePage, QWidget#ScheduleListPage,
QWidget#ReminderHistoryPage, QWidget#SettingsPage {
    background: #F5F7F8;
}

QToolTip {
    color: #FFFFFF;
    background: #17232E;
    border: none;
    padding: 6px 9px;
}

/* Navigation */
#NavigationBar {
    background: #17232E;
    border: none;
}
#BrandMark {
    color: #FFFFFF;
    background: #2B7A78;
    border-radius: 7px;
    font-size: 16pt;
    font-weight: 700;
}
#BrandName { color: #FFFFFF; font-size: 11pt; font-weight: 700; }
#BrandSubtitle { color: #A8B7C2; font-size: 10pt; }
#NavSection {
    color: #718596;
    font-size: 10pt;
    font-weight: 700;
    padding: 0 10px 6px 10px;
}
QPushButton#NavButton {
    color: #B9C6D0;
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 0 12px;
    text-align: left;
    font-weight: 500;
}
QPushButton#NavButton:hover { color: #FFFFFF; background: #223441; }
QPushButton#NavButton[active="true"] {
    color: #FFFFFF;
    background: #2B7A78;
    font-weight: 700;
}
#ServiceStatus { color: #7BC6A4; font-size: 10pt; padding: 8px 8px 2px 8px; }
#VersionLabel { color: #91A2AE; font-size: 10pt; padding: 0 8px; }
#DeveloperContact { color: #91A2AE; font-size: 9pt; padding: 5px 8px 0 8px; }

/* Page hierarchy */
#PageTitle { color: #18242E; font-size: 22pt; font-weight: 700; }
#PageSubtitle { color: #667681; font-size: 11pt; }
#SectionTitle { color: #18242E; font-size: 14pt; font-weight: 700; }
#SectionHint, #MutedLabel { color: #6F7D87; font-size: 11pt; }
#CountLabel { color: #5F6D78; font-size: 11pt; font-weight: 600; }

/* Surfaces */
#LeftPanel { background: #F5F7F8; border: none; }
#InputCard, #ScheduleCard, #SettingsCard, #ToolbarCard, #EmptyState {
    background: #FFFFFF;
    border: 1px solid #E1E6E9;
    border-radius: 7px;
}
#InputCard:focus, #ScheduleCard:hover { border-color: #A8C9C7; }
#ImageDropZone {
    background: #F9FBFB;
    border: 1px dashed #AFC0C7;
    border-radius: 7px;
}
#ImageDropZone:hover { background: #F2F8F7; border-color: #2B7A78; }
#ImageDropZone:focus { background: #EDF7F5; border: 2px solid #2B7A78; }
#ScheduleCard:hover { background: #FBFDFD; }
#UrgencyBar { background: #2B7A78; border-radius: 2px; }
#StatusBadge {
    color: #49606D;
    background: #EDF2F3;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 10pt;
    font-weight: 600;
}
#ScheduleSelect { spacing: 0; }

/* Buttons */
QPushButton {
    min-height: 38px;
    border-radius: 5px;
    padding: 0 14px;
    font-weight: 600;
}
QPushButton#PrimaryButton {
    color: #FFFFFF;
    background: #2B7A78;
    border: 1px solid #2B7A78;
}
QPushButton#PrimaryButton:hover { background: #236966; border-color: #236966; }
QPushButton#PrimaryButton:pressed { background: #1C5A58; }
QPushButton#PrimaryButton:disabled { background: #A8C7C5; border-color: #A8C7C5; }
QPushButton#SecondaryButton, QPushButton#SmallButton {
    color: #42515D;
    background: #FFFFFF;
    border: 1px solid #D7DEE2;
}
QPushButton#SecondaryButton:hover, QPushButton#SmallButton:hover {
    color: #1E6866;
    background: #F4F9F8;
    border-color: #8DB9B6;
}
QPushButton#GhostButton { color: #49606D; background: transparent; border: none; }
QPushButton#GhostButton:hover { color: #1E6866; background: #EDF5F4; }
QPushButton#DangerButton { color: #A54848; background: #FFFFFF; border: 1px solid #E5CCCC; }
QPushButton#DangerButton:hover { background: #FFF5F5; border-color: #D89B9B; }
QPushButton#PrimarySmallButton { color: #FFFFFF; background: #2B7A78; border: none; }
QPushButton#ModelModeButton {
    color: #52616C; background: #F3F6F7; border: 1px solid #D5DEE2;
}
QPushButton#ModelModeButton:hover { color: #1E6866; border-color: #91BBB8; }
QPushButton#ModelModeButton[active="true"] {
    color: #FFFFFF; background: #2B7A78; border-color: #2B7A78;
}
#ModelFieldLabel { color: #334550; font-size: 10pt; font-weight: 700; }
#ModelModeHint { color: #6F7D87; font-size: 10pt; }
#ModelSettingsScroll, #ModelSettingsContent { background: transparent; border: none; }

/* Inputs */
QTextEdit, QLineEdit, QComboBox, QSpinBox {
    color: #26343F;
    background: #FFFFFF;
    border: 1px solid #D7DEE2;
    border-radius: 5px;
    padding: 7px 10px;
    selection-background-color: #B9DAD7;
    min-height: 32px;
}
QTextEdit:focus, QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #2B7A78;
}
QLineEdit:disabled, QComboBox:disabled { color: #9AA5AD; background: #F1F3F4; }
QDialog#ScheduleEditDialog { background: #F7F9FA; }
#EditDialogTitle { color: #18242E; font-size: 17pt; font-weight: 700; }
#EditDialogHint { color: #667681; font-size: 10pt; }
QDateEdit, QTimeEdit {
    color: #26343F; background: #FFFFFF; border: 1px solid #D7DEE2;
    border-radius: 5px; padding: 7px 10px; min-height: 32px;
}
QDateEdit:focus, QTimeEdit:focus { border: 1px solid #2B7A78; }
QDateEdit:disabled, QTimeEdit:disabled { color: #9AA5AD; background: #F1F3F4; }
QComboBox { min-height: 24px; }
QComboBox::drop-down { width: 28px; border: none; }
QSpinBox::up-button, QSpinBox::down-button { width: 22px; border: none; }

/* Settings */
#StepPosition {
    color: #53636E;
    font-size: 11pt;
    font-weight: 600;
    padding: 4px 2px;
}
#StepIndicator {
    color: #697984;
    background: #E9EEF0;
    border: 1px solid #D9E0E3;
    border-radius: 6px;
    font-size: 11pt;
    font-weight: 600;
    padding: 0 8px;
}
#StepIndicator[stepState="active"] {
    color: #FFFFFF;
    background: #2B7A78;
    border-color: #2B7A78;
}
#StepIndicator[stepState="complete"] {
    color: #235F5D;
    background: #E3F0EE;
    border-color: #A8CCC8;
}
#SettingsStepTitle {
    color: #18242E;
    font-size: 15pt;
    font-weight: 700;
}
#SettingsStepHint {
    color: #667681;
    font-size: 11pt;
}
#SettingsCard QLineEdit, #SettingsCard QComboBox, #SettingsCard QSpinBox {
    min-height: 32px;
}
#SettingsCard QFormLayout QLabel {
    color: #465762;
    font-size: 12pt;
}
QGroupBox {
    color: #26343F;
    background: #FFFFFF;
    border: 1px solid #E1E6E9;
    border-radius: 7px;
    margin-top: 14px;
    padding: 22px 18px 16px 18px;
    font-weight: 700;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 6px;
    color: #26343F;
}
QFormLayout QLabel { color: #53626E; }

/* Tabs and scrolling */
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QTabWidget::pane { background: transparent; border: none; border-top: 1px solid #DDE3E6; }
QTabBar::tab {
    color: #697984;
    background: transparent;
    border: none;
    padding: 10px 18px;
    font-weight: 600;
}
QTabBar::tab:selected { color: #246D6A; border-bottom: 2px solid #2B7A78; }
QTabBar::tab:hover { color: #246D6A; }
QScrollBar:vertical {
    width: 16px;
    background: #E9EEF0;
    border: 1px solid #D3DDE1;
    border-radius: 7px;
    margin: 17px 1px;
}
QScrollBar::handle:vertical {
    background: #6E9197;
    border: 2px solid #E9EEF0;
    border-radius: 6px;
    min-height: 54px;
}
QScrollBar::handle:vertical:hover { background: #367F7C; }
QScrollBar::handle:vertical:pressed { background: #236B68; }
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    height: 16px;
    background: #DCE5E7;
    border: 1px solid #C5D2D6;
    border-radius: 6px;
}
QScrollBar::sub-line:vertical { subcontrol-position: top; subcontrol-origin: margin; }
QScrollBar::add-line:vertical { subcontrol-position: bottom; subcontrol-origin: margin; }
QScrollBar::sub-page:vertical, QScrollBar::add-page:vertical { background: transparent; }
QScrollBar:horizontal {
    height: 16px;
    background: #E9EEF0;
    border: 1px solid #D3DDE1;
    border-radius: 7px;
    margin: 1px 17px;
}
QScrollBar::handle:horizontal {
    background: #6E9197;
    border: 2px solid #E9EEF0;
    border-radius: 6px;
    min-width: 54px;
}
QScrollBar::handle:horizontal:hover { background: #367F7C; }
QScrollBar::handle:horizontal:pressed { background: #236B68; }
QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    width: 16px;
    background: #DCE5E7;
    border: 1px solid #C5D2D6;
    border-radius: 6px;
}
QScrollBar::sub-line:horizontal { subcontrol-position: left; subcontrol-origin: margin; }
QScrollBar::add-line:horizontal { subcontrol-position: right; subcontrol-origin: margin; }
QScrollBar::sub-page:horizontal, QScrollBar::add-page:horizontal { background: transparent; }

QMenu {
    color: #26343F;
    background: #FFFFFF;
    border: 1px solid #DDE3E6;
    padding: 6px;
}
QMenu::item { padding: 7px 24px 7px 10px; border-radius: 4px; }
QMenu::item:selected { background: #EAF3F2; color: #1F6664; }

#ShimmerLoader { background: #F4F8F8; border: 1px solid #DCE8E7; border-radius: 7px; }
#ToastNotification { background: #FFFFFF; border: 1px solid #D8E0E4; border-radius: 8px; }
