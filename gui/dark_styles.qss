/* Have you forgotten? - night theme */
* {
    font-family: "Microsoft YaHei UI", "Segoe UI";
    font-size: 13pt;
    color: #E4ECEA;
}

QMainWindow, QWidget#HomePage, QWidget#ScheduleListPage,
QWidget#ReminderHistoryPage, QWidget#SettingsPage {
    background: #171D1F;
}

QToolTip {
    color: #F4F8F7;
    background: #0D1315;
    border: 1px solid #405053;
    padding: 6px 9px;
}

/* Navigation */
#NavigationBar { background: #101719; border: none; }
#BrandMark { color: #F5FFFD; background: #277E78; border-radius: 7px; font-size: 16pt; font-weight: 700; }
#BrandName { color: #F4F8F7; font-size: 11pt; font-weight: 700; }
#BrandSubtitle { color: #9EB1B2; font-size: 10pt; }
#NavSection { color: #799092; font-size: 10pt; font-weight: 700; padding: 0 10px 6px 10px; }
QPushButton#NavButton { color: #C4D1D0; background: transparent; border: none; border-radius: 6px; padding: 0 12px; text-align: left; font-weight: 500; }
QPushButton#NavButton:hover { color: #FFFFFF; background: #21363A; }
QPushButton#NavButton[active="true"] { color: #FFFFFF; background: #287D78; font-weight: 700; }
#ServiceStatus { color: #78C7A3; font-size: 10pt; padding: 8px 8px 2px 8px; }
#VersionLabel, #DeveloperContact { color: #91A6A7; font-size: 10pt; padding: 0 8px; }
#DeveloperContact { font-size: 9pt; padding: 5px 8px 0 8px; }

/* Page hierarchy and surfaces */
#PageTitle, #SectionTitle, #SettingsStepTitle { color: #F0F5F4; font-weight: 700; }
#PageTitle { font-size: 22pt; }
#SectionTitle { font-size: 14pt; }
#SettingsStepTitle { font-size: 15pt; }
#PageSubtitle, #SectionHint, #MutedLabel, #SettingsStepHint { color: #AABDBC; font-size: 11pt; }
#CountLabel { color: #B3C3C2; font-size: 11pt; font-weight: 600; }
#LeftPanel { background: #171D1F; border: none; }
#InputCard, #ScheduleCard, #SettingsCard, #ToolbarCard, #EmptyState, #ManualAddPanel {
    background: #222B2D; border: 1px solid #3B494B; border-radius: 7px;
}
#ManualAddPanel { background: #1C2527; border-color: #4A5B5D; }
#ManualAddTitle { color: #E7EFED; font-size: 12pt; font-weight: 700; }
#LeftScroll { background: transparent; border: none; }
#InputCard:focus, #ScheduleCard:hover { border-color: #509D97; }
#ScheduleCard:hover { background: #263133; }
#ImageDropZone { background: #1D2628; border: 1px dashed #597274; border-radius: 7px; }
#ImageDropZone:hover { background: #233335; border-color: #36958D; }
#ImageDropZone:focus { background: #243638; border: 2px solid #48A59E; }
#UrgencyBar { background: #36958D; border-radius: 2px; }
#StatusBadge { color: #C0D0CF; background: #314144; border-radius: 4px; padding: 3px 8px; font-size: 10pt; font-weight: 600; }
#ScheduleSelect { spacing: 0; }

/* Buttons and inputs */
QPushButton { min-height: 38px; border-radius: 5px; padding: 0 14px; font-weight: 600; }
QPushButton#PrimaryButton { color: #F7FFFD; background: #2F9089; border: 1px solid #2F9089; }
QPushButton#PrimaryButton:hover { background: #38A198; border-color: #38A198; }
QPushButton#PrimaryButton:pressed { background: #24746F; }
QPushButton#PrimaryButton:disabled { color: #D3E0DE; background: #527A77; border-color: #527A77; }
QPushButton#SecondaryButton, QPushButton#SmallButton { color: #D8E3E1; background: #222B2D; border: 1px solid #4A5B5D; }
QPushButton#SecondaryButton:hover, QPushButton#SmallButton:hover { color: #A8F0E8; background: #29393B; border-color: #4C9E98; }
QPushButton#GhostButton { color: #B8C9C8; background: transparent; border: none; }
QPushButton#GhostButton:hover { color: #A8F0E8; background: #29393B; }
QPushButton#DangerButton { color: #FFB0AA; background: #222B2D; border: 1px solid #875C5A; }
QPushButton#DangerButton:hover { background: #3B292A; border-color: #BC7470; }
QPushButton#PrimarySmallButton { color: #FFFFFF; background: #2F9089; border: none; }
QPushButton#ModelModeButton { color: #B9C9C8; background: #1B2426; border: 1px solid #4A5B5D; }
QPushButton#ModelModeButton:hover { color: #A8F0E8; border-color: #4C9E98; }
QPushButton#ModelModeButton[active="true"] { color: #FFFFFF; background: #2F9089; border-color: #2F9089; }
#ModelFieldLabel { color: #D4E0DE; font-size: 10pt; font-weight: 700; }
#ModelModeHint { color: #9EB2B1; font-size: 10pt; }
#ModelSettingsScroll, #ModelSettingsContent { background: transparent; border: none; }
QTextEdit, QLineEdit, QComboBox, QSpinBox { color: #E5EDEC; background: #192124; border: 1px solid #4A5A5C; border-radius: 5px; padding: 7px 10px; selection-background-color: #317C77; min-height: 32px; }
QTextEdit:focus, QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1px solid #43A79F; }
QLineEdit:disabled, QComboBox:disabled { color: #839594; background: #1C2325; }
QDialog#ScheduleEditDialog { background: #171D1F; }
#EditDialogTitle { color: #F0F5F4; font-size: 17pt; font-weight: 700; }
#EditDialogHint { color: #AABDBC; font-size: 10pt; }
QDateEdit, QTimeEdit {
    color: #E5EDEC; background: #192124; border: 1px solid #4A5A5C;
    border-radius: 5px; padding: 7px 10px; min-height: 32px;
}
QDateEdit:focus, QTimeEdit:focus { border: 1px solid #43A79F; }
QDateEdit:disabled, QTimeEdit:disabled { color: #839594; background: #1C2325; }
QComboBox { min-height: 24px; }
QComboBox::drop-down { width: 28px; border: none; }
QSpinBox::up-button, QSpinBox::down-button { width: 22px; border: none; }
QComboBox QAbstractItemView { color: #E5EDEC; background: #222B2D; border: 1px solid #4A5A5C; selection-background-color: #2F9089; }

/* Settings, tabs, scrolling and transient surfaces */
#ThemeLabel { color: #B7C8C7; font-size: 10pt; font-weight: 600; }
#ThemeCombo { min-width: 128px; }
#StepPosition { color: #B2C4C2; font-size: 11pt; font-weight: 600; padding: 4px 2px; }
#StepIndicator { color: #AFC1C0; background: #253032; border: 1px solid #425154; border-radius: 6px; font-size: 11pt; font-weight: 600; padding: 0 8px; }
#StepIndicator[stepState="active"] { color: #FFFFFF; background: #2F9089; border-color: #2F9089; }
#StepIndicator[stepState="complete"] { color: #B7E7E2; background: #244947; border-color: #3C807A; }
#SettingsCard QLineEdit, #SettingsCard QComboBox, #SettingsCard QSpinBox { min-height: 32px; }
#SettingsCard QFormLayout QLabel, QFormLayout QLabel { color: #C1D0CF; font-size: 12pt; }
QGroupBox { color: #E4ECEA; background: #222B2D; border: 1px solid #3B494B; border-radius: 7px; margin-top: 14px; padding: 22px 18px 16px 18px; font-weight: 700; }
QGroupBox::title { subcontrol-origin: margin; left: 14px; padding: 0 6px; color: #E4ECEA; }
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QTabWidget::pane { background: transparent; border: none; border-top: 1px solid #405052; }
QTabBar::tab { color: #A8B9B8; background: transparent; border: none; padding: 10px 18px; font-weight: 600; }
QTabBar::tab:selected { color: #80D8D0; border-bottom: 2px solid #3A9B94; }
QTabBar::tab:hover { color: #A8F0E8; }
QScrollBar:vertical {
    width: 16px;
    background: #202A2C;
    border: 1px solid #3D4C4F;
    border-radius: 7px;
    margin: 17px 1px;
}
QScrollBar::handle:vertical {
    background: #71908F;
    border: 2px solid #202A2C;
    border-radius: 6px;
    min-height: 54px;
}
QScrollBar::handle:vertical:hover { background: #48A59E; }
QScrollBar::handle:vertical:pressed { background: #5DC1B8; }
QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    height: 16px;
    background: #2D3A3C;
    border: 1px solid #46585A;
    border-radius: 6px;
}
QScrollBar::sub-line:vertical { subcontrol-position: top; subcontrol-origin: margin; }
QScrollBar::add-line:vertical { subcontrol-position: bottom; subcontrol-origin: margin; }
QScrollBar::sub-page:vertical, QScrollBar::add-page:vertical { background: transparent; }
QScrollBar:horizontal {
    height: 16px;
    background: #202A2C;
    border: 1px solid #3D4C4F;
    border-radius: 7px;
    margin: 1px 17px;
}
QScrollBar::handle:horizontal {
    background: #71908F;
    border: 2px solid #202A2C;
    border-radius: 6px;
    min-width: 54px;
}
QScrollBar::handle:horizontal:hover { background: #48A59E; }
QScrollBar::handle:horizontal:pressed { background: #5DC1B8; }
QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    width: 16px;
    background: #2D3A3C;
    border: 1px solid #46585A;
    border-radius: 6px;
}
QScrollBar::sub-line:horizontal { subcontrol-position: left; subcontrol-origin: margin; }
QScrollBar::add-line:horizontal { subcontrol-position: right; subcontrol-origin: margin; }
QScrollBar::sub-page:horizontal, QScrollBar::add-page:horizontal { background: transparent; }
QMenu { color: #E5EDEC; background: #222B2D; border: 1px solid #425254; padding: 6px; }
QMenu::item { padding: 7px 24px 7px 10px; border-radius: 4px; }
QMenu::item:selected { background: #294846; color: #B4F4ED; }
QMessageBox { background: #222B2D; }
#ShimmerLoader { background: #1F2B2C; border: 1px solid #3B5555; border-radius: 7px; }
#ToastNotification { background: #222B2D; border: 1px solid #466062; border-radius: 8px; }
